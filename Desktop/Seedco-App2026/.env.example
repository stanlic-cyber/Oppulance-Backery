# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Environment mode (development or production)
NODE_ENV=development

# Server port
PORT=3000

# ============================================
# MONGODB DATABASE
# ============================================

# MongoDB connection URI
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://user:password@cluster.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=seedco

# ============================================
# APPLICATION URLs
# ============================================

# The URL where this application is hosted
# Used for self-referential links, OAuth callbacks, and API endpoints
APP_URL=http://localhost:3000

# ============================================
# NOTES
# ============================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to version control
# 3. For development, MongoDB can run locally or via Docker:
#    docker run -d -p 27017:27017 mongo:latest
# 4. For production, use a managed MongoDB service such as Atlas.
