# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

PORT=3000

# Gmail address that will SEND the notification emails (can be the same as EMAIL_TO)
EMAIL_USER=youraddress@gmail.com

# A Gmail App Password — NOT your normal Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be turned on for your Google account first.)
EMAIL_PASS=your16characterapppassword

# The default address that should RECEIVE contact form and subscription notifications
EMAIL_TO=matemarumbidzai2@gmail.com

# Dedicated public inboxes
SUPPORT_EMAIL=support@corelinesystem.co.zw
INFO_EMAIL=info@corelinesystem.co.zw
